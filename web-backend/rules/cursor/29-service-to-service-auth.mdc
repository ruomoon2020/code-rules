description: 服务之间的调用身份，不是登录用户
globs:
  - "src/main/java/**/*Client.java"
  - "src/main/java/**/*Feign*.java"
  - "src/main/java/**/*Consumer.java"
  - "src/main/java/**/*Job.java"
  - "src/main/java/**/*Webhook*.java"
alwaysApply: false
